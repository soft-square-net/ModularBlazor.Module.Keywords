{
  "openapi": "3.1.1",
  "info": {
    "title": "Keywords",
    "description": "Keywords: the concepts content is about (people, organizations, places, topics), with names per language, aliases and sameAs links, as schema.org JSON-LD.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/keywords/concepts": {
      "get": {
        "tags": [
          "Concepts"
        ],
        "summary": "One page of concepts by name; search matches any label (case, accents and Arabic letter forms ignored) or the slug.",
        "operationId": "Keywords_ListConcepts",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeRetired",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConceptPage"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Concepts"
        ],
        "operationId": "Keywords_CreateConcept",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConceptValues"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConceptDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/keywords/concepts/lookup": {
      "get": {
        "tags": [
          "Concepts"
        ],
        "summary": "The concepts with these ids, in the order asked (retired ones too); unknown ids are left out.",
        "operationId": "Keywords_LookupConcepts",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32"
              }
            }
          },
          {
            "name": "language",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ConceptSummaryDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/keywords/concepts/types": {
      "get": {
        "tags": [
          "Concepts"
        ],
        "operationId": "Keywords_ListConceptTypes",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ConceptType"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/keywords/concepts/{id}": {
      "get": {
        "tags": [
          "Concepts"
        ],
        "operationId": "Keywords_GetConcept",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "language",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConceptDto"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Concepts"
        ],
        "operationId": "Keywords_EditConcept",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConceptEdit"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConceptDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/keywords/concepts/{id}/jsonld": {
      "get": {
        "tags": [
          "Concepts"
        ],
        "summary": "The concept as schema.org JSON-LD (type, name in the language, alternateName, description, sameAs).",
        "operationId": "Keywords_GetConceptJsonLd",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "language",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConceptJsonLdDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/keywords/concepts/{id}/retire": {
      "post": {
        "tags": [
          "Concepts"
        ],
        "operationId": "Keywords_RetireConcept",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VersionRead"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConceptDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/keywords/concepts/{id}/restore": {
      "post": {
        "tags": [
          "Concepts"
        ],
        "operationId": "Keywords_RestoreConcept",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VersionRead"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConceptDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConceptDto": {
        "required": [
          "id",
          "slug",
          "type",
          "name",
          "description",
          "status",
          "labels",
          "sameAs",
          "related",
          "createdBy",
          "createdAt",
          "updatedAt",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "slug": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/ConceptStatus"
          },
          "labels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LabelValue"
            }
          },
          "sameAs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConceptRefDto"
            }
          },
          "createdBy": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ConceptEdit": {
        "required": [
          "version",
          "values"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "values": {
            "$ref": "#/components/schemas/ConceptValues"
          }
        }
      },
      "ConceptJsonLdDto": {
        "required": [
          "id",
          "name",
          "jsonLd"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "jsonLd": {
            "type": "object"
          }
        }
      },
      "ConceptPage": {
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConceptSummaryDto"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ConceptRefDto": {
        "required": [
          "id",
          "slug",
          "type",
          "name",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "slug": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ConceptStatus"
          }
        }
      },
      "ConceptStatus": {
        "enum": [
          "Active",
          "Retired"
        ],
        "type": "string"
      },
      "ConceptSummaryDto": {
        "required": [
          "id",
          "slug",
          "type",
          "name",
          "languages",
          "alternateNames",
          "description",
          "status",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "slug": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alternateNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/ConceptStatus"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ConceptType": {
        "required": [
          "name",
          "parent",
          "label",
          "description"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "parent": {
            "type": [
              "null",
              "string"
            ]
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ConceptValues": {
        "required": [
          "type",
          "labels"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LabelValue"
            }
          },
          "slug": {
            "type": [
              "null",
              "string"
            ]
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "sameAs": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "related": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        }
      },
      "LabelKind": {
        "enum": [
          "Preferred",
          "Alternate",
          "Hidden"
        ],
        "type": "string",
        "default": "Preferred"
      },
      "LabelValue": {
        "required": [
          "language",
          "text"
        ],
        "type": "object",
        "properties": {
          "language": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/LabelKind"
          }
        }
      },
      "VersionRead": {
        "required": [
          "version"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://localhost:5090/connect/authorize",
            "tokenUrl": "http://localhost:5090/connect/token",
            "scopes": {
              "openid": "User identity",
              "profile": "User profile",
              "email": "User email",
              "api": "Access to Modular WebApi",
              "offline_access": "Refresh token"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "OAuth2": [
        "openid",
        "profile",
        "email",
        "api"
      ]
    }
  ],
  "tags": [
    {
      "name": "Concepts"
    }
  ]
}