@attribute [ClientDialog(KeywordsDialogs.PickConcepts, Title = "Choose keywords", MaxWidth = "640px")]
@inherits KeywordsPageBase

@*
  Dialog "Module.Keywords/pick-concepts" (see KeywordsDialogs.PickConcepts): search the tenant's concepts in any
  language and choose one or more; a name that is not there yet can be added on the spot (keywords.manage).
    parameters  { multiple?: bool, selected?: [ids], type?: string, language?: string, exclude?: [ids],
                  suggestions?: [names] }
    result      { ids: [...], concepts: [{ id, name, type, slug }] }
  suggestions: names the caller proposes (an AI's keywords, words of the text), shown as chips above the results.
  Clicking one searches for it and also matches it (POST /concepts/match: Arabic ta marbuta and a leading al- ignored
  too), so its concepts come first; when nothing matches, "Add as a new concept" is offered for it as for any search.
  The dialog never chooses for the caller: a suggestion is only a search.
  Shown on other modules' pages too (the DynamicFields editor, Taxonomies), so its styles are kw- classes only.
*@

<div class="mud-dialog-content kw-picker">
  <form class="kw-picker-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
    <div class="mud-input-wrapper mud-input-wrapper--dense kw-picker-query">
      <input type="search" class="mud-input-slot" @bind="_query" @bind:event="oninput" @bind:after="SearchAsync"
             placeholder="@L["Search any name, any language"]" aria-label="@L["Search concepts"]" autofocus />
    </div>
    @if (_fixedType is null)
    {
      <div class="mud-input-wrapper mud-input-wrapper--dense mud-input-wrapper--select">
        <select class="mud-input-slot" @bind="_type" @bind:after="SearchAsync" aria-label="@L["Type"]">
          <option value="">@L["All types"]</option>
          @foreach (var t in _types) { <option value="@t.Name">@KeywordsUi.Indent(t, _types)@t.Label</option> }
        </select>
      </div>
    }
  </form>

  @if (_suggestions.Count > 0)
  {
    <div class="kw-chips kw-picker-suggestions" role="group" aria-label="@L["Suggested names"]">
      <span class="mud-typography mud-typography-caption mn-muted">@L["Suggested:"]</span>
      @foreach (var name in _suggestions)
      {
        var n = name;
        var on = string.Equals(_query.Trim(), n, StringComparison.Ordinal);
        <button type="button" class="mn-chip kw-chip kw-suggestion @(on ? "kw-on" : "")" aria-pressed="@(on ? "true" : "false")"
                title="@L["Search for \"{0}\"", n]" @onclick="() => SuggestAsync(n)">@n</button>
      }
    </div>
  }

  @if (_multiple && _selected.Count > 0)
  {
    <div class="kw-chips kw-picker-selected" aria-label="@L["Chosen"]">
      @foreach (var s in _selected)
      {
        var c = s;
        <span class="mn-chip kw-chip">@c.Name <button type="button" class="kw-chip-remove" @onclick="() => Toggle(c)" aria-label="@L["Remove {0}", c.Name]">✕</button></span>
      }
    </div>
  }

  @if (Error is not null)
  {
    <p class="mud-typography mud-typography-body2 mn-error" role="alert">@Error</p>
  }

  <ul class="kw-picker-results" role="listbox" aria-multiselectable="@(_multiple ? "true" : "false")">
    @foreach (var item in _results)
    {
      var c = item;
      var on = _selected.Any(s => s.Id == c.Id);
      <li role="option" aria-selected="@(on ? "true" : "false")" class="@(on ? "kw-on" : "")" @onclick="() => PickAsync(c)">
        @if (_multiple) { <input type="checkbox" checked="@on" tabindex="-1" aria-hidden="true" /> }
        <span class="kw-picker-name">
          <strong>@c.Name</strong>
          <span class="mn-chip">@KeywordsUi.TypeLabel(c.Type, _types)</span>
          @if (c.AlternateNames.Count > 0) { <span class="mn-muted"> @string.Join(" · ", c.AlternateNames.Take(3))</span> }
          @if (c.Description is { Length: > 0 } d) { <span class="kw-picker-description mn-muted">@d</span> }
        </span>
      </li>
    }
  </ul>
  @if (_results.Count == 0 && !Busy)
  {
    <p class="mud-typography mud-typography-body2 mn-muted">@(_query.Trim().Length == 0 ? L["No concepts yet."] : L["Nothing matches \"{0}\".", _query.Trim()])</p>
  }
  @if (_more > 0) { <p class="mud-typography mud-typography-body2 mn-muted">@L["{0} more: type more of the name to narrow it down.", _more]</p> }

  @if (_query.Trim().Length > 0 && !_results.Any(r => string.Equals(r.Name, _query.Trim(), StringComparison.OrdinalIgnoreCase)))
  {
    <details class="kw-picker-new" open="@(_results.Count == 0)">
      <summary>@L["Add \"{0}\" as a new concept", _query.Trim()]</summary>
      <div class="kw-picker-new-row">
        <div class="mud-input-wrapper mud-input-wrapper--dense mud-input-wrapper--select">
          <select class="mud-input-slot" @bind="_newType" aria-label="@L["Type of the new concept"]">
            @foreach (var t in _types.Where(t => _fixedType is null || t.Name == _fixedType)) { <option value="@t.Name">@KeywordsUi.Indent(t, _types)@t.Label</option> }
          </select>
        </div>
        <div class="mud-input-wrapper mud-input-wrapper--dense kw-label-language">
          <input class="mud-input-slot" @bind="_newLanguage" maxlength="16" aria-label="@L["Language of the name"]" />
        </div>
        <button type="button" class="mud-button-root mud-button-filled mud-button-primary mud-button-small" @onclick="CreateAsync" disabled="@Busy">@L["Add"]</button>
      </div>
      <p class="mud-typography mud-typography-caption mn-muted">@L["Names in other languages and links can be added on the Keywords page later."]</p>
    </details>
  }
</div>
<div class="mud-dialog-actions">
  <button type="button" class="mud-button-root mud-button-text mud-button-medium" @onclick="Dialog.Cancel">@L["Cancel"]</button>
  @if (_multiple)
  {
    <button type="button" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium" @onclick="Done">@L["Choose ({0})", _selected.Count]</button>
  }
</div>

@code {
  [CascadingParameter] public IDialogReference Dialog { get; set; } = default!;

  /// <summary>The caller's parameters (web JSON).</summary>
  private sealed record Parameters(bool? Multiple, List<string>? Selected, string? Type, string? Language, List<string>? Exclude,
    List<string>? Suggestions);

  private const int MaxSuggestions = 20; // what one POST /concepts/match takes

  private const int PageSize = 20;

  private bool _multiple;
  private string? _fixedType;
  private string? _language;
  private HashSet<int> _exclude = [];
  private List<string> _suggestions = [];
  private IReadOnlyList<ConceptType> _types = [];
  private List<ConceptSummaryDto> _results = [];
  private readonly List<ConceptSummaryDto> _selected = [];
  private string _query = "";
  private string _type = "";
  private string _newType = "Thing";
  private string _newLanguage = "en";
  private int _more;
  private int _searchNumber;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    var parameters = Dialog.GetParameters<Parameters>();
    _multiple = parameters?.Multiple == true;
    _fixedType = string.IsNullOrWhiteSpace(parameters?.Type) ? null : parameters.Type.Trim();
    _language = string.IsNullOrWhiteSpace(parameters?.Language) ? null : parameters.Language.Trim();
    _exclude = [.. (parameters?.Exclude ?? []).Select(Number).Where(n => n > 0)];
    _suggestions = [.. (parameters?.Suggestions ?? []).Where(n => !string.IsNullOrWhiteSpace(n)).Select(n => n.Trim())
      .Distinct(StringComparer.OrdinalIgnoreCase).Take(MaxSuggestions)];
    _newLanguage = _language ?? "en";
    _newType = _fixedType ?? "Thing";

    var selected = (parameters?.Selected ?? []).Select(Number).Where(n => n > 0).Distinct().ToList();
    await RunAsync(async () =>
    {
      _types = await Api.ListConceptTypesAsync();
      if (selected.Count > 0) _selected.AddRange(await Api.LookupConceptsAsync(selected, _language));
    }, toast: false);
    await SearchAsync();
  }

  private static int Number(string? id) => int.TryParse(id, out var n) ? n : 0;

  private async Task SearchAsync()
  {
    var number = ++_searchNumber;
    var query = _query.Trim();
    var type = _fixedType ?? (_type.Length > 0 ? _type : null);
    var suggested = query.Length > 0 && _suggestions.Contains(query, StringComparer.Ordinal);
    ConceptPage? page = null;
    IReadOnlyList<ConceptSummaryDto> matched = [];
    await RunAsync(async () =>
    {
      page = await Api.ListConceptsAsync(1, PageSize, query.Length > 0 ? query : null, type, _language, false);
      if (suggested) matched = await MatchedAsync(query, type);
    }, toast: false);
    if (number != _searchNumber || page is null) return; // a newer search is on its way
    var found = page.Items.Select(c => c.Id).ToHashSet();
    _results = [.. matched.Where(c => !found.Contains(c.Id)).Concat(page.Items).Where(c => !_exclude.Contains(c.Id))];
    _more = Math.Max(0, page.Total - page.Items.Count);
    StateHasChanged(); // the first search runs from OnAfterRenderAsync, which does not re-render by itself
  }

  /// <summary>A suggestion clicked: search for it (again, if it is the query already).</summary>
  private Task SuggestAsync(string name)
  {
    _query = name;
    return SearchAsync();
  }

  /// <summary>The concepts POST /concepts/match finds for a suggested name, best first, as the list shows them.</summary>
  private async Task<IReadOnlyList<ConceptSummaryDto>> MatchedAsync(string name, string? type)
  {
    var terms = await Api.MatchConceptsAsync(new ConceptMatchRequest { Terms = [name], Language = _language, Type = type });
    var ids = terms.SelectMany(t => t.Matches).Select(m => m.Id).Distinct().ToList();
    return ids.Count == 0 ? [] : await Api.LookupConceptsAsync(ids, _language);
  }

  private void Toggle(ConceptSummaryDto concept)
  {
    var at = _selected.FindIndex(s => s.Id == concept.Id);
    if (at >= 0) _selected.RemoveAt(at);
    else _selected.Add(concept);
  }

  private Task PickAsync(ConceptSummaryDto concept)
  {
    if (_multiple) Toggle(concept);
    else
    {
      _selected.Clear();
      _selected.Add(concept);
      Done();
    }
    return Task.CompletedTask;
  }

  private async Task CreateAsync()
  {
    var name = _query.Trim();
    if (name.Length == 0) return;
    ConceptDto? created = null;
    var ok = await RunAsync(async () => created = await Api.CreateConceptAsync(new ConceptValues
    {
      Type = _newType,
      Labels = [new LabelValue { Language = _newLanguage.Trim().Length > 0 ? _newLanguage.Trim() : "en", Text = name, Kind = LabelKind.Preferred }]
    }), toast: false);
    if (!ok || created is null) return;

    var summary = new ConceptSummaryDto
    {
      Id = created.Id, Slug = created.Slug, Type = created.Type, Name = created.Name, Status = created.Status, Version = created.Version,
      Languages = [.. created.Labels.Select(l => l.Language).Distinct()], AlternateNames = []
    };
    _results.Insert(0, summary);
    await PickAsync(summary);
  }

  private void Done() => Dialog.Close(new
  {
    ids = _selected.Select(c => c.Id.ToString()).ToArray(),
    concepts = _selected.Select(c => new { id = c.Id.ToString(), name = c.Name, type = c.Type, slug = c.Slug }).ToArray()
  });
}
